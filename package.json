{
  "name": "api-editor",
  "displayName": "API Editor",
  "description": "%description%",
  "version": "1.0.0",
  "publisher": "beatahumeniuk",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "openapi",
    "swagger",
    "wsdl",
    "xsd",
    "avro",
    "api",
    "contract",
    "schema",
    "designer"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Beata-Humeniuk/api-editor.git"
  },
  "homepage": "https://github.com/Beata-Humeniuk/api-editor#readme",
  "bugs": {
    "url": "https://github.com/Beata-Humeniuk/api-editor/issues"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "API Editor",
      "properties": {}
    },
    "commands": [
      {
        "command": "apiEditor.editGui",
        "title": "%command.editGui%",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "apiEditor.newContract",
        "title": "%command.newContract%",
        "category": "API Editor"
      },
      {
        "command": "apiEditor.exportMd",
        "title": "%command.exportMd%",
        "category": "API Editor"
      },
      {
        "command": "apiEditor.convertContract",
        "title": "%command.convertContract%",
        "category": "API Editor"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "apiEditor.exportMd",
          "when": "false"
        },
        {
          "command": "apiEditor.convertContract",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "apiEditor.editGui",
          "when": "resourceLangId == json || resourceLangId == jsonc || resourceLangId == yaml || resourceLangId == xml || resourceExtname == .wsdl || resourceExtname == .xsd || resourceExtname == .avsc",
          "group": "1_modification"
        }
      ],
      "explorer/context": [
        {
          "command": "apiEditor.editGui",
          "when": "resourceExtname == .json || resourceExtname == .yaml || resourceExtname == .yml || resourceExtname == .wsdl || resourceExtname == .xsd || resourceExtname == .xml || resourceExtname == .avsc",
          "group": "7_modification"
        }
      ],
      "editor/title": [
        {
          "command": "apiEditor.editGui",
          "when": "resourceLangId == json || resourceLangId == jsonc || resourceLangId == yaml || resourceLangId == xml || resourceExtname == .wsdl || resourceExtname == .xsd || resourceExtname == .avsc",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "esbuild src/extension.js --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --minify --charset=utf8",
    "test": "node test/nls-test.js && node test/designer-smoke.js && node test/reload-test.js && node test/md-export-test.js && node test/md-export-wsdl-xsd-avro-test.js && node test/write-if-changed-test.js && node test/avro-write-back-test.js && node test/dir-segment-test.js && node test/schema-convert-test.js && node test/theme-contrast-test.js",
    "package": "npm run build && vsce package --no-dependencies",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@vscode/vsce": "2.32.0",
    "esbuild": "^0.21.5"
  }
}
